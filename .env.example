# Copy to .env and fill in. .env holds login credentials: chmod 600 it and never commit it.
#
# Extension phase: this file is OPTIONAL. The extension sends the league ids, the
# SWID and the AI settings with each request. Only the service settings matter.
# The ESPN cookie and the notification settings are for the BACKGROUND phase (paused).

# --- local service for the Chrome extension (always bound to 127.0.0.1) ---
SERVICE_PORT=8765
EXTENSION_ID=            # optional: accept only this extension id (chrome://extensions)

# --- ESPN, BACKGROUND PHASE ONLY (a private league needs both cookies; copy them from your browser) ---
ESPN_LEAGUE_IDS=         # one or more, comma separated: 1669256142,<second league>
ESPN_YEAR=2026
ESPN_S2=
ESPN_SWID=
ESPN_TEAM_IDS=           # optional, per league: 1669256142:16. Normally detected from SWID

# --- time ---
TIMEZONE=America/Denver
QUIET_HOURS=23-8
ACTIVE_LEAD_HOURS=2
CHECK_INTERVAL_SECONDS=600

# --- analysis thresholds ---
DOUBTFUL_DISCOUNT=0.25
QUESTIONABLE_DISCOUNT=0.9
LINEUP_MIN_GAIN=1.0
FA_MIN_GAIN=1.0
FA_MIN_WEEK_GAIN=3.0
# v2 (trades)
TRADE_MIN_GAIN=1.0
TRADE_MIN_PARTNER_GAIN=0.3

# --- AI (optional). The extension panel has its own fields; these are only a fallback ---
AI_PROVIDER=anthropic    # or openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_EFFORT=low

# --- notification channels: fill in the ones you want, several can be active ---
EMAIL_FROM=
EMAIL_PASSWORD=          # Gmail app password
EMAIL_TO=
NTFY_TOPIC=              # use a long random string
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- health ---
HEALTHCHECK_URL=         # optional healthchecks.io ping after each good run

# --- misc ---
LOG_LEVEL=INFO
# FFAI_DB_PATH=          # default ./ffai.db; docker-compose sets /data/ffai.db
