# Copy to .env and fill in. .env holds login credentials: chmod 600 it and never commit it.

# --- ESPN (private league needs both cookies; copy them from your browser) ---
ESPN_LEAGUE_ID=
ESPN_YEAR=2026
ESPN_S2=
ESPN_SWID=
ESPN_TEAM_ID=            # optional; detected from SWID when empty

# --- time ---
TIMEZONE=America/Denver
QUIET_HOURS=23-8
ACTIVE_LEAD_HOURS=2
CHECK_INTERVAL_SECONDS=600

# --- analysis thresholds ---
DOUBTFUL_DISCOUNT=0.25
QUESTIONABLE_DISCOUNT=0.9
LINEUP_MIN_GAIN=1.0
FA_MIN_GAIN=1.0
FA_MIN_WEEK_GAIN=3.0
# v2 (trades)
TRADE_MIN_GAIN=1.0
TRADE_MIN_PARTNER_GAIN=0.3

# --- AI (optional; without a key the messages use plain templates) ---
AI_PROVIDER=anthropic    # or openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_EFFORT=low

# --- notification channels: fill in the ones you want, several can be active ---
EMAIL_FROM=
EMAIL_PASSWORD=          # Gmail app password
EMAIL_TO=
NTFY_TOPIC=              # use a long random string
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- health ---
HEALTHCHECK_URL=         # optional healthchecks.io ping after each good run

# --- misc ---
LOG_LEVEL=INFO
# FFAI_DB_PATH=          # default ./ffai.db; docker-compose sets /data/ffai.db
