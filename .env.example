# Copy this file to .env and fill it in. .env holds login credentials.
# Run chmod 600 on it and never commit it.
#
# Extension phase: this file is OPTIONAL.
# The extension sends the league ids, the SWID and the AI settings with each request.
# Only the service settings matter in this phase.
# The ESPN cookie and the notification settings belong to the BACKGROUND phase (paused).

# Local service for the Chrome extension. It always listens on 127.0.0.1.
SERVICE_PORT=8765
EXTENSION_ID=            # Optional. The service accepts only this extension id (see chrome://extensions).

# ESPN settings for the BACKGROUND PHASE only.
# A private league needs both cookies. Copy them from your browser.
ESPN_LEAGUE_IDS=         # One or more ids, separated by commas: 1669256142,<second league>
ESPN_YEAR=2026
ESPN_S2=
ESPN_SWID=
ESPN_TEAM_IDS=           # Optional, for each league: 1669256142:16. The program normally detects the team from the SWID.

# Time settings
TIMEZONE=America/Denver
QUIET_HOURS=23-8
ACTIVE_LEAD_HOURS=2
CHECK_INTERVAL_SECONDS=600

# Analysis thresholds
DOUBTFUL_DISCOUNT=0.25
QUESTIONABLE_DISCOUNT=0.9
LINEUP_MIN_GAIN=1.0
FA_MIN_GAIN=1.0
FA_MIN_WEEK_GAIN=3.0
# Version 2 (trades)
TRADE_MIN_GAIN=1.0
TRADE_MIN_PARTNER_GAIN=0.3

# AI settings (optional). The extension panel has its own fields. These values are only a fallback.
AI_PROVIDER=anthropic    # "anthropic" or "openai"
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_EFFORT=low

# Notification channels. Fill in the channels that you want. Several channels can be active.
EMAIL_FROM=
EMAIL_PASSWORD=          # Gmail app password
EMAIL_TO=
NTFY_TOPIC=              # Use a long random string.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Health
HEALTHCHECK_URL=         # Optional. A healthchecks.io ping after each good run.

# Other settings
LOG_LEVEL=INFO
# FFAI_DB_PATH=          # The default is ./ffai.db. docker-compose sets /data/ffai.db.
